{
  "_comment": [
    "What `devkit export` copies from ${HOME}/.agents into core/.",
    "JSON rather than YAML: the installer parses this with the stdlib only.",
    "",
    "layer is the client/toolchain split. 'core' ships in every profile. 'enonic' and 'client'",
    "are overlays a profile opts into. Anything absent from this file is not",
    "exported, and hard_excludes wins over every allowlist entry.",
    "",
    "Adding a skill here is a publication decision: run `devkit export --check`",
    "and read the gitleaks report before trusting it.",
    "hard_excludes are anchored at the export root. Prefix with **/ to match a directory of that name at any depth — an unanchored `graft/` would also drop skills/graft/.",
    "benchmarks/20* keeps the monthly per-source fetches out; the hand-kept inputs and the merged latest.yaml snapshot ship through the benchmarks section."
  ],
  "source": "${HOME}/.agents",
  "target": "core",
  "hard_excludes": [
    ".auth/",
    "prds/",
    "plans/",
    "history/",
    "deliverables/",
    "kb/worklog/",
    ".cache/",
    ".packages/",
    "tmp/",
    "local-vendor-folders/",
    ".playwright-mcp/",
    ".playwright-cli/",
    "tests/",
    "backups/",
    "graft/",
    "benchmarks/20*",
    "**/__pycache__/",
    "**/*.pyc",
    "**/.DS_Store",
    "**/*.lock"
  ],
  "skills": {
    "core": [
      "archify",
      "audit-heavy-report",
      "blank-space",
      "classify-ticket-autonomy",
      "color-palette",
      "context7-mcp",
      "describe-image",
      "diff-image",
      "download-jira-task",
      "draft-commit-message",
      "draw-diagram",
      "find-skills",
      "generate-worklogs",
      "google-translate",
      "graft",
      "grill-me",
      "grilling",
      "handoff",
      "humanize-text",
      "lint-and-draft-commit-message",
      "multitask-same-repo",
      "plan-implementation",
      "plan-task-evidence",
      "playwright-cli",
      "ponytail-review",
      "read-figma",
      "render-diff-patch",
      "run-plan",
      "set-up-worktree",
      "skillspector",
      "spawn-playwright-mcp",
      "tesseract-cli",
      "validate-impl",
      "validate-plan",
      "wait-what",
      "write-analyst-message"
    ],
    "enonic": [
      "apply-react4xp-practices",
      "debug-xp-app",
      "develop-react4xp-v5",
      "develop-react4xp-v6",
      "develop-react4xp-v7",
      "develop-xp7-backend",
      "develop-xp8",
      "set-up-enonic-react4xp",
      "test-xp-apps",
      "upgrade-xp-app",
      "use-enonic-cli"
    ],
    "excluded": {
      "_comment": "Personal or unshippable. Reason is recorded so the list is auditable.",
      "develop-godot-2d": "personal, not work tooling",
      "develop-godot-3d": "personal, not work tooling",
      "dsnote": "personal, not work tooling",
      "enonic-marketplace": "no SKILL.md; a reference directory, not a skill",
      "extract-agentic": "needs the separately installed extractkit",
      "extract-legacy": "names a client review host and needs the separately installed extractkit",
      "godot-game-dev-shared": "no SKILL.md; shared assets for the godot skills",
      "graphify": "opt-in, heavy, superseded by graft for this kit",
      "ppt-master": "gitignored multi-hundred-MB asset trees; 14 of the 23 broken links"
    },
    "core_excludes": [
      "archify/examples/**",
      "archify/test/**"
    ]
  },
  "skills_vendor": {
    "core": [
      "claude",
      "codex",
      "cursor"
    ],
    "files": [
      "ROLES.md"
    ],
    "core_excludes": [
      "claude/graphify/**",
      "codex/graphify/**"
    ],
    "excluded": {
      "_comment": "Vendor projections of skills the skills section keeps out.",
      "claude/graphify": "skills.excluded.graphify",
      "codex/graphify": "skills.excluded.graphify"
    }
  },
  "rules": {
    "_comment": "AGENTS.md is generated from manifest.json, so the generator and its inputs ship, not a rendered snapshot. `devkit project build` runs generate-agents-md.py --layer <project layers> to render it.",
    "core": [
      "manifest.json",
      "agents.d/",
      "BASE.md",
      "BASE.mdc",
      "browser-mcp-preference.mdc",
      "git.mdc",
      "graft.mdc",
      "history-automatic-logging.mdc",
      "local-first-deterministic-tools.mdc",
      "memory-filesystem.mdc",
      "multitask-same-repo.mdc",
      "orchestrate-cursor-models.mdc",
      "prefer-python-over-shell.mdc",
      "response-formatting.mdc",
      "serena.mdc",
      "session-store-isolation.mdc",
      "user-scope-exclusions.mdc",
      "vendor-vision-image-preview.mdc"
    ],
    "enonic": [
      "enonic-thymeleaf-negation.mdc",
      "enonic-xp-nashorn-template-strings.mdc"
    ],
    "client": [
      "evidence-post-on-failure-ask.mdc",
      "jira-comment-edit-backup.mdc",
      "jira-evidence-persistent-content.mdc",
      "jira-screenshot-consistency.mdc",
      "token-efficiency-chat.mdc"
    ],
    "excluded": {
      "graphify.mdc": "graphify skill is not exported",
      "AGENTS.md": "generated at install from manifest.json plus agents.d; do not export a snapshot"
    }
  },
  "kb": {
    "core": [
      "_shared/**",
      "validation/**",
      "implementation/**",
      "offline-reference/scripts/**",
      "calibration/classify-ticket-autonomy/How-to-calibrate-classify-ticket-autonomy.md",
      "calibration/classify-ticket-autonomy/Calibration-runs-of-classify-ticket-autonomy-anonymized.md"
    ],
    "core_excludes": [
      "implementation/enonic-cli/**",
      "implementation/xp7-to-xp8-upgrade/**",
      "implementation/How-to-import-legacy-claude-personal-sessions-into-the-personal-profile.md",
      "implementation/How-to-sync-claude-desktop-personal-on-apt-upgrade.md"
    ],
    "enonic": [
      "offline-reference/README.md",
      "offline-reference/xp7/**",
      "offline-reference/xp8/**",
      "offline-reference/react4xp-5.x/**",
      "offline-reference/react4xp-6.x/**",
      "offline-reference/react4xp-stable/**",
      "offline-reference/content-studio-5.x/**",
      "offline-reference/content-studio-stable/**",
      "implementation/enonic-cli/**",
      "implementation/xp7-to-xp8-upgrade/**"
    ],
    "client": [
      "testing/**"
    ],
    "excluded": {
      "offline-reference/godot-2d/**": "personal",
      "offline-reference/godot-3d/**": "personal",
      "worklog/**": "personal, already a hard exclude",
      "implementation/How-to-import-legacy-claude-personal-sessions-into-the-personal-profile.md": "machine-specific one-off; superseded by `devkit profile session-sync`",
      "calibration/classify-ticket-autonomy/Calibration-runs-of-classify-ticket-autonomy.md": "specific Jira keys; host-local run log",
      "calibration/classify-ticket-autonomy/Corpus-precedents-for-classify-ticket-autonomy.md": "specific Jira keys; host-local precedent map",
      "calibration/llm-index.md": "indexes the host-local corpus files",
      "implementation/How-to-sync-claude-desktop-personal-on-apt-upgrade.md": "documents bin/sync-claude-desktop-personal.py, which is excluded; kit appfork replaces it"
    }
  },
  "bin": {
    "core": [
      "agentctl",
      "agentctl.py",
      "agentctl_bench.py",
      "agentctl_code.py",
      "agentctl_common.py",
      "agentctl_docs.py",
      "agentctl_image.py",
      "agentctl_jira.py",
      "agentctl_kb.py",
      "agentctl_plan.py",
      "agentctl_security.py",
      "agentctl_skills.py",
      "backfill-claude-jsonl-ai-titles.py",
      "backup-claude-mcp.py",
      "cursor-recolor-apply.sh",
      "cursor-tgrep-rg-apply.py",
      "export-canvas-html",
      "export-canvas-html.py",
      "export-codex-sessions-to-claude.py",
      "export-cursor-sessions-to-claude.py",
      "generate-agents-md.py",
      "gitlab-mcp",
      "gitlab-mcp.py",
      "install-cursor-recolor.sh",
      "install-cursor-tgrep-rg.sh",
      "merge-claude-config.py",
      "serena-mcp",
      "serena-mcp.py",
      "sync-bin-projections.sh",
      "sync-skill-projections.sh",
      "tgrep-cursor-apply.py",
      "tgrep-serve-pool.py",
      "verify-links.sh"
    ],
    "excluded": {
      "docker-prune-keep-home-volumes.py": "hardcodes /home/volumes; machine layout, not harness",
      "fix-claude-desktop-personal-perms.sh": "companion to the Personal desktop fork; kit appfork owns profile dest trees",
      "recolor-white-black-icons.sh": "generalized into install.py",
      "review-auth": "reads the harness .auth/<user>.passwd; client credential flow",
      "scheduled-push-branches.py": "one-shot client cron; hardcodes acme-group keys",
      "sync-claude-desktop-personal.py": "Personal desktop fork worker; kit appfork rebuilds per-profile GUI forks"
    }
  },
  "bin_vendor": {
    "_comment": "Per-vendor scripts that sync-bin-projections.sh links into each vendor scripts dir.",
    "core": [
      "claude",
      "codex",
      "cursor"
    ],
    "excluded": {
      "claude_personal": "Claude Personal is no longer a harness (e52fda9)"
    }
  },
  "hooks": {
    "core": [
      "history.py",
      "claude-history-adapter.py",
      "codex-history-adapter.py",
      "cursor-memory.py",
      "memory-recall.sh",
      "kb-router.py",
      "deny-git-push.sh",
      "claude-deny-git-push.sh",
      "git-push-policy.sh",
      "history-log-prompt.sh",
      "history-log-response.sh",
      "history-log-stop.sh",
      "graft-hooks.cjs",
      "graft-statusline.cjs",
      "response-format-check.py"
    ]
  },
  "benchmarks": {
    "_comment": "Inputs to `agentctl bench place` plus the snapshot ROLES.md was derived from. Monthly fetches stay out via hard_excludes.",
    "core": [
      "harness.yaml",
      "bands.yaml",
      "models.yaml",
      "overrides.yaml",
      "latest.yaml",
      "placement.yaml"
    ]
  },
  "mcp": {
    "core": [
      "README.md",
      "catalog.json",
      "env.example",
      "install.py",
      "playwright.py",
      "serena/auto-onboard.yml",
      "test_playwright.py",
      "image-to-disk/README.md",
      "image-to-disk/server.py",
      "image-to-disk/test_server.py"
    ],
    "excluded": {
      "graft": "removed from catalog 2026-09-27; directory is .cache, do not re-admit"
    }
  },
  "config": {
    "core": [
      "client-overlay.example.json"
    ],
    "excluded": {
      "client-overlay.json": "the real client overlay; the client profile ships its own",
      "export-scrub.json": "private scrub rules; they name what the kit must not track, so they stay out of it"
    }
  },
  "agents": {
    "core": [
      "**"
    ]
  },
  "vendor": {
    "core": [
      "tgrep-cursor"
    ]
  }
}
