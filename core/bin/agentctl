def cmd_worklog_collect(args: argparse.Namespace) -> int:
    day = (
        dt.date.fromisoformat(args.date)
        if args.date
        else dt.datetime.now().astimezone().date()
    )
    history = agents_home() / "history" / day.isoformat()
    prompts = sorted(str(path) for path in history.glob("*_prompt.md")) if history.is_dir() else []
    result: dict[str, Any] = {"date": day.isoformat(), "history": {"count": len(prompts), "files": prompts},
                              "git": [], "collector": None}
    collector = agents_home() / "skills" / "generate-worklogs" / "scripts" / "collect-daily-evidence.py"
    if collector.is_file():
        collected = run([sys.executable, str(collector), day.isoformat()])
        cache_dir = agents_home() / ".cache" / "worklogs"
        cache_dir.mkdir(parents=True, exist_ok=True)
        cache_file = cache_dir / f"{day.isoformat()}.txt"
        cache_file.write_text(collected.stdout, encoding="utf-8")
        result["collector"] = {"exit_code": collected.returncode, "cache": str(cache_file),
                               "bytes": len(collected.stdout.encode())}
        for line in collected.stdout.splitlines():
            if line.startswith("REPO|"):
                parts = line.split("|", 2)
                result["git"].append({"repo": parts[1], "details": parts[2] if len(parts) > 2 else ""})
    database = agents_home() / ".cache" / "worklogs" / "evidence.sqlite"
    database.parent.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(database)
    try:
        connection.execute(
            "CREATE TABLE IF NOT EXISTS daily_evidence ("
            "day TEXT PRIMARY KEY, payload TEXT NOT NULL, updated_at TEXT NOT NULL)"
        )
        connection.execute(
            "INSERT OR REPLACE INTO daily_evidence(day, payload, updated_at) VALUES (?, ?, ?)",
            (day.isoformat(), json.dumps(result, ensure_ascii=False), dt.datetime.now().astimezone().isoformat()),
        )
        connection.commit()
    finally:
        connection.close()
    result["cache_database"] = str(database)
    emit(result)
    return 0


def first_line(text: str) -> str:
    return next((line.strip() for line in text.splitlines() if line.strip()), "")[:240]


def cmd_tools_audit(args: argparse.Namespace) -> int:
    tools = []
    for name in RECOMMENDED_TOOLS:
        path = shutil.which(name)
        item: dict[str, Any] = {"name": name, "available": bool(path), "path": path}
        if path and args.versions:
            for flag in ("--version", "-version", "-v"):
                result = run([path, flag])
                if result.returncode == 0 and (result.stdout or result.stderr):
                    item["version"] = first_line(result.stdout or result.stderr)
                    break
        tools.append(item)
    packages = []
    for name in RECOMMENDED_PYTHON_PACKAGES:
        probe = run([sys.executable, "-c", f"import {name}; print(getattr({name}, '__version__', 'unknown'))"])
        packages.append({
            "name": name,
            "available": probe.returncode == 0,
            "version": probe.stdout.strip() if probe.returncode == 0 else None,
        })
    token_path = agentctl_jira.TOKEN_PATH
    jira_token: dict[str, Any] = {"path": str(token_path), "present": token_path.is_file()}
    if token_path.is_file():
        try:
            jira_token.update(agentctl_jira.public_auth(agentctl_jira.load_credentials(token_path)))
        except (OSError, ValueError) as exc:
            jira_token["error"] = str(exc)
    nvidia_path = agents_home() / ".auth" / "nvidia-api-key.yaml"
    nvidia_token: dict[str, Any] = {"path": str(nvidia_path), "present": nvidia_path.is_file()}
    if nvidia_path.is_file():
        try:
            nvidia_token.update(public_nvidia_auth(nvidia_path))
        except (OSError, ValueError) as exc:
            nvidia_token["error"] = str(exc)
    emit({
        "available": sum(1 for item in tools if item["available"]),
        "missing": [item["name"] for item in tools if not item["available"]],
        "tools": tools,
        "python_packages": packages,
        "python_packages_missing": [item["name"] for item in packages if not item["available"]],
        "jira_token": jira_token,
        "nvidia_token": nvidia_token,
    })
    return 0


def scoped_files(cwd: Path, scope: str) -> tuple[Path, list[Path]]:
    root = repo_root(cwd) or cwd.resolve()
    if scope == "changed" and repo_root(cwd):
        names: set[str] = set()
        for command in (
            ("diff", "--name-only"),
            ("diff", "--cached", "--name-only"),
            ("ls-files", "--others", "--exclude-standard"),
        ):
            result = git(root, *command)
            names.update(line for line in result.stdout.splitlines() if line)
        paths = [root / name for name in sorted(names) if (root / name).is_file()]
    else:
        excluded = {".git", "node_modules", "build", "dist", ".gradle", ".venv", "venv"}
        paths = [
            path for path in root.rglob("*")
            if path.is_file() and not any(part in excluded for part in path.relative_to(root).parts)
        ]
    return root, paths[:500]


def cmd_checks_run(args: argparse.Namespace) -> int:
    root, paths = scoped_files(args.cwd.resolve(), args.scope)
    groups: dict[str, list[Path]] = {
        "python": [path for path in paths if path.suffix == ".py"],
        "shell": [path for path in paths if path.suffix in {".sh", ".bash"}],
        "markdown": [path for path in paths if path.suffix.lower() in {".md", ".mdx"}],
        "xml": [path for path in paths if path.suffix.lower() == ".xml"],
        "yaml": [path for path in paths if path.suffix.lower() in {".yaml", ".yml"}],
    }
    specs: list[tuple[str, str, list[str], list[Path]]] = [
        ("ruff", "ruff", ["check", "--output-format=json"], groups["python"]),
        ("shellcheck", "shellcheck", ["--format=json1"], groups["shell"]),
        ("markdownlint", "markdownlint-cli2", [], groups["markdown"]),
        ("xmllint", "xmllint", ["--noout"], groups["xml"]),
        ("yq", "yq", ["."], groups["yaml"]),
        ("codespell", "codespell", ["--quiet-level=2"], groups["python"] + groups["markdown"]),
    ]
    checks: list[dict[str, Any]] = []
    for label, executable, prefix, selected in specs:
        path = shutil.which(executable)
        if not selected:
            checks.append({"check": label, "status": "skipped", "reason": "no matching files"})
            continue
        if not path:
            checks.append({"check": label, "status": "unavailable", "executable": executable})
            continue
        command = [path, *prefix, *[str(item.relative_to(root)) for item in selected[:200]]]
        result = run(command, cwd=root)
        output = (result.stdout + ("\n" if result.stdout and result.stderr else "") + result.stderr).strip()
        checks.append({
            "check": label,
            "status": "passed" if result.returncode == 0 else "failed",
            "exit_code": result.returncode,
            "files": len(selected[:200]),
            "output": output[: argsafe_limit(args.max_output_chars)],
            "truncated": len(output) > args.max_output_chars,
        })
    failed = [item["check"] for item in checks if item["status"] == "failed"]
    emit({"repo": str(root), "scope": args.scope, "files": len(paths), "failed": failed, "checks": checks})
    return 2 if failed else 0


# Local parity for the group/ci-templates application security baseline (INT-238).
# Tool choice, flags, severity defaults, and skip rules follow
# security-skills/SETTINGS.md; the exclusion list mirrors DS_EXCLUDED_PATHS in
# ci-templates general/gitlab-security-baseline.yml.

SECURITY_OUTPUT_DIR = ".security-local"
SECURITY_SEVERITIES = ("UNKNOWN", "LOW", "MEDIUM", "HIGH", "CRITICAL")
SECURITY_CHECKS = ("secrets", "deps", "sast", "iac")
# sast and iac are slow and noisy on first run; they stay opt-in via --check.
SECURITY_DEFAULT_CHECKS = ("secrets", "deps")

DEPENDENCY_LOCKFILES = (
    "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb",
    "composer.lock", "Gemfile.lock", "go.mod", "Cargo.lock", "poetry.lock",
    "Pipfile.lock", "requirements.txt", "gradle.lockfile",
)

SECURITY_EXCLUDED_DIRS = (
    "vendor", "node_modules", ".gradle", "build", "dist", "test", "tests",
    "spec", "tmp", ".git", SECURITY_OUTPUT_DIR,
)

SOURCE_SUFFIXES = {
    ".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".es6", ".php", ".py",
    ".java", ".kt", ".rb", ".go", ".cs", ".rs", ".scala",
}

# Enonic layouts first (SETTINGS.md): scan sources, never compiled output.
SAST_ROOT_CANDIDATES = ("xp/src", "xp/assets/src", "src", "app", "lib", "packages")
IAC_DIR_CANDIDATES = ("environments", "charts", "chart", "k8s", "kubernetes", "deploy", "terraform", "docker")
IAC_FILE_GLOBS = ("Chart.yaml", "docker-compose*.yml", "docker-compose*.yaml",
                  "compose.yaml", "compose.yml", "*.tf")

SEVERITY_ALIASES = {
    "ERROR": "HIGH", "WARNING": "MEDIUM", "WARN": "MEDIUM", "INFO": "LOW",
    "MODERATE": "MEDIUM", "IMPORTANT": "HIGH", "NONE": "UNKNOWN", "": "UNKNOWN",
}


def normalize_severity(value: Any) -> str:
    text = str(value or "").strip().upper()
    text = SEVERITY_ALIASES.get(text, text)
    return text if text in SECURITY_SEVERITIES else "UNKNOWN"


def severity_from_score(score: Any) -> str:
    try:
        number = float(score)
    except (TypeError, ValueError):
        return "UNKNOWN"
    if number >= 9.0:
        return "CRITICAL"
    if number >= 7.0:
        return "HIGH"
    if number >= 4.0:
        return "MEDIUM"
    return "LOW" if number > 0 else "UNKNOWN"


def security_excluded(root: Path, path: Path) -> bool:
    return any(part in SECURITY_EXCLUDED_DIRS for part in path.relative_to(root).parts)


def dependency_lockfiles(root: Path) -> list[str]:
    found: list[str] = []
    for path in root.rglob("*"):
        if not path.is_file() or security_excluded(root, path):
            continue
        if path.name in DEPENDENCY_LOCKFILES:
            found.append(str(path.relative_to(root)))
        if len(found) >= 50:
            break
    return sorted(found)


def sast_roots(root: Path) -> list[str]:
    roots = [name for name in SAST_ROOT_CANDIDATES if (root / name).is_dir()]
    if roots:
        return roots
    for path in root.rglob("*"):
        if path.is_file() and path.suffix in SOURCE_SUFFIXES and not security_excluded(root, path):
            return ["."]
    return []


def iac_targets(root: Path) -> list[str]:
    targets = {name for name in IAC_DIR_CANDIDATES if (root / name).is_dir()}
    for pattern in IAC_FILE_GLOBS:
        targets.update(str(path.relative_to(root)) for path in root.glob(pattern))
        targets.update(
            str(path.relative_to(root)) for path in root.glob(f"*/{pattern}")
            if not security_excluded(root, path)
        )
    return sorted(targets)


def security_applicability(root: Path) -> dict[str, dict[str, Any]]:
    lockfiles = dependency_lockfiles(root)
    roots = sast_roots(root)
    iac = iac_targets(root)
    return {
        "secrets": {"applies": True, "targets": ["."], "reason": "always applicable"},
        "deps": {
            "applies": bool(lockfiles), "targets": lockfiles[:20],
            "reason": "lockfile or manifest present" if lockfiles else "no dependency lockfile found",
        },
        "sast": {
            "applies": bool(roots), "targets": roots,
            "reason": "source roots present" if roots else "no scannable source files",
        },
        "iac": {
            "applies": bool(iac), "targets": iac,
            "reason": "deploy or infrastructure definitions present" if iac else "no IaC or deploy files",
        },
    }


def security_plan(check: str, root: Path, out_dir: Path, targets: list[str]) -> dict[str, Any] | None:
    """Tool invocation for one check, or None when no tool is installed."""
    rel_out = out_dir.relative_to(root)
    all_severities = ",".join(SECURITY_SEVERITIES)
    skip_dirs = [arg for name in SECURITY_EXCLUDED_DIRS for arg in ("--skip-dirs", name)]
    if check == "secrets":
        artifact = rel_out / "gitleaks.json"
        # --no-git scans the working tree, which is what SETTINGS.md specifies and the
        # only mode that sees uncommitted changes or a directory that is not a repo.
        # Commit-range scanning (--log-opts) stays a separate pre-push step.
        # --exit-code 0 keeps "found leaks" distinct from "gitleaks crashed".
        return {"tool": "gitleaks", "artifact": artifact, "args": [
            "detect", "--source", ".", "--no-git", "--no-banner", "--redact",
            "--exit-code", "0", "--report-format", "json", "--report-path", str(artifact),
        ]}
    if check == "deps":
        if shutil.which("trivy"):
            artifact = rel_out / "trivy-deps.json"
            return {"tool": "trivy", "artifact": artifact, "args": [
                "fs", "--scanners", "vuln,license", "--severity", all_severities,
                "--format", "json", "--output", str(artifact), *skip_dirs, ".",
            ]}
        artifact = rel_out / "osv-scanner.json"
        return {"tool": "osv-scanner", "artifact": artifact, "args": [
            "scan", "source", "--recursive", "--format", "json",
            "--output-file", str(artifact), ".",
        ]}
    if check == "sast":
        artifact = rel_out / "semgrep.json"
        excludes = [arg for name in SECURITY_EXCLUDED_DIRS for arg in ("--exclude", name)]
        return {"tool": "semgrep", "artifact": artifact, "args": [
            "scan", "--config", "p/ci", "--metrics", "off", "--quiet",
            "--json", "--output", str(artifact), *excludes, *targets,
        ]}
    if check == "iac":
        artifact = rel_out / "trivy-config.json"
        # trivy config takes one target; scan the root and exclude noise instead.
        # Rendered-manifest scanning (helm template) stays a manual step per SETTINGS.md.
        return {"tool": "trivy", "artifact": artifact, "args": [
            "config", "--severity", all_severities, "--format", "json",
            "--output", str(artifact), *skip_dirs, ".",
        ]}
    return None


def findings_from_gitleaks(data: Any) -> list[dict[str, Any]]:
    # Gitleaks reports no severity; a committed secret is treated as HIGH.
    return [{
        "severity": "HIGH",
        "id": item.get("RuleID"),
        "title": item.get("Description"),
        "location": f"{item.get('File')}:{item.get('StartLine')}",
    } for item in (data or []) if isinstance(item, dict)]


def findings_from_trivy(data: Any) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    for result in (data or {}).get("Results") or []:
        target = result.get("Target") or ""
        for vuln in result.get("Vulnerabilities") or []:
            findings.append({
                "severity": normalize_severity(vuln.get("Severity")),
                "id": vuln.get("VulnerabilityID"),
                "title": f"{vuln.get('PkgName')} {vuln.get('InstalledVersion')}".strip(),
                "location": target,
            })
        for miscfg in result.get("Misconfigurations") or []:
            findings.append({
                "severity": normalize_severity(miscfg.get("Severity")),
                "id": miscfg.get("ID"),
                "title": miscfg.get("Title"),
                "location": f"{target}:{(miscfg.get('CauseMetadata') or {}).get('StartLine', '')}".rstrip(":"),
            })
    return findings


def findings_from_osv(data: Any) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    for result in (data or {}).get("results") or []:
        source = (result.get("source") or {}).get("path") or ""
        for package in result.get("packages") or []:
            name = (package.get("package") or {}).get("name") or ""
            scores: dict[str, str] = {}
            for group in package.get("groups") or []:
                bucket = severity_from_score(group.get("max_severity"))
                for identifier in group.get("ids") or []:
                    scores[identifier] = bucket
            for vuln in package.get("vulnerabilities") or []:
                identifier = vuln.get("id")
                severity = normalize_severity((vuln.get("database_specific") or {}).get("severity"))
                if severity == "UNKNOWN":
                    severity = scores.get(identifier, "UNKNOWN")
                findings.append({
                    "severity": severity,
                    "id": identifier,
                    "title": (vuln.get("summary") or name)[:200],
                    "location": f"{source}:{name}".rstrip(":"),
                })
    return findings


def findings_from_semgrep(data: Any) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    for item in (data or {}).get("results") or []:
        extra = item.get("extra") or {}
        findings.append({
            "severity": normalize_severity(extra.get("severity")),
            "id": item.get("check_id"),
            "title": (extra.get("message") or "").strip()[:200],
            "location": f"{item.get('path')}:{(item.get('start') or {}).get('line')}",
        })
    return findings


def sniff_report_tool(data: Any) -> str | None:
    if isinstance(data, list):
        return "gitleaks" if not data or "RuleID" in (data[0] or {}) else None
    if not isinstance(data, dict):
        return None
    if "Results" in data:
        return "trivy"
    results = data.get("results")
    if isinstance(results, list):
        if any("check_id" in item for item in results if isinstance(item, dict)):
            return "semgrep"
        if any("source" in item for item in results if isinstance(item, dict)):
            return "osv-scanner"
        return "semgrep" if "paths" in data else "osv-scanner"
    return None


def relative_location(location: str, root: Path | None) -> str:
    if not root or not location:
        return location
    prefix = f"{root}/"
    return location.removeprefix(prefix)


def read_findings(path: Path, root: Path | None = None) -> tuple[str | None, list[dict[str, Any]]]:
    if not path.is_file() or not path.stat().st_size:
        return None, []
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return None, []
    tool = sniff_report_tool(data)
    readers = {
        "gitleaks": findings_from_gitleaks,
        "trivy": findings_from_trivy,
        "osv-scanner": findings_from_osv,
        "semgrep": findings_from_semgrep,
    }
    reader = readers.get(tool or "")
    if not reader:
        return tool, []
    findings = reader(data)
    for item in findings:
        item["location"] = relative_location(item["location"], root)
    return tool, findings


def summarize_findings(findings: list[dict[str, Any]], top: int) -> dict[str, Any]:
    counts = {name: 0 for name in SECURITY_SEVERITIES}
    for item in findings:
        counts[item["severity"]] = counts.get(item["severity"], 0) + 1
    ranked = sorted(findings, key=lambda item: -SECURITY_SEVERITIES.index(item["severity"]))
    return {"total": len(findings), "by_severity": counts, "top": ranked[:argsafe_limit(top)]}


def gate_tripped(counts: dict[str, int], fail_on: str | None) -> bool:
    if not fail_on:
        return False
    threshold = SECURITY_SEVERITIES.index(normalize_severity(fail_on))
    return any(
        count > 0 for name, count in counts.items()
        if SECURITY_SEVERITIES.index(name) >= threshold
    )


def cmd_security_detect(args: argparse.Namespace) -> int:
    cwd = args.cwd.resolve()
    root = repo_root(cwd) or cwd
    applicability = security_applicability(root)
    emit({
        "root": str(root),
        "default_checks": list(SECURITY_DEFAULT_CHECKS),
        "opt_in_checks": [name for name in SECURITY_CHECKS if name not in SECURITY_DEFAULT_CHECKS],
        "applicable": [name for name, item in applicability.items() if item["applies"]],
        "checks": applicability,
    })
    return 0


def cmd_security_scan(args: argparse.Namespace) -> int:
    cwd = args.cwd.resolve()
    root = repo_root(cwd) or cwd
    requested = [name.strip() for name in args.check.split(",") if name.strip()]
    unknown = [name for name in requested if name not in SECURITY_CHECKS]
    if unknown:
        emit({"status": "error", "error": f"unknown checks: {', '.join(unknown)}",
              "valid": list(SECURITY_CHECKS)})
        return 1
    out_dir = root / SECURITY_OUTPUT_DIR
    out_dir.mkdir(parents=True, exist_ok=True)
    applicability = security_applicability(root)
    totals = {name: 0 for name in SECURITY_SEVERITIES}
    checks: list[dict[str, Any]] = []
    for name in requested:
        applies = applicability[name]
        if not applies["applies"]:
            checks.append({"check": name, "status": "skipped", "reason": applies["reason"]})
            continue
        plan = security_plan(name, root, out_dir, applies["targets"])
        executable = shutil.which(plan["tool"])
        if not executable:
            checks.append({"check": name, "status": "unavailable", "tool": plan["tool"]})
            continue
        artifact = root / plan["artifact"]
        artifact.unlink(missing_ok=True)
        result = run([executable, *plan["args"]], cwd=root, timeout=args.timeout)
        tool, findings = read_findings(artifact, root)
        summary = summarize_findings(findings, args.top)
        for severity, count in summary["by_severity"].items():
            totals[severity] += count
        produced = artifact.is_file() and artifact.stat().st_size > 0
        entry = {
            "check": name,
            "status": "completed" if produced else "error",
            "tool": tool or plan["tool"],
            "exit_code": result.returncode,
            "artifact": str(artifact),
            "targets": applies["targets"][:20],
            **summary,
        }
        if not produced:
            stderr = (result.stderr or result.stdout or "").strip()
            entry["error"] = stderr[: argsafe_limit(args.max_output_chars)] or "no report produced"
        checks.append(entry)
    errored = [item["check"] for item in checks if item["status"] == "error"]
    tripped = gate_tripped(totals, args.fail_on)
    emit({
        "root": str(root),
        "output_dir": str(out_dir),
        "gitignored": SECURITY_OUTPUT_DIR in (root / ".gitignore").read_text(encoding="utf-8")
        if (root / ".gitignore").is_file() else False,
        "requested": requested,
        "totals": totals,
        "fail_on": args.fail_on,
        "gate_tripped": tripped,
        "errored": errored,
        "checks": checks,
    })
    return 2 if tripped or errored else 0


def cmd_security_summarize(args: argparse.Namespace) -> int:
    tool, findings = read_findings(args.report.resolve())
    if tool is None:
        emit({"status": "error", "report": str(args.report),
              "error": "unrecognized or empty report; expected gitleaks, trivy, osv-scanner, or semgrep JSON"})
        return 1
    summary = summarize_findings(findings, args.top)
    tripped = gate_tripped(summary["by_severity"], args.fail_on)
    emit({"report": str(args.report), "tool": tool, "fail_on": args.fail_on,
          "gate_tripped": tripped, **summary})
    return 2 if tripped else 0


TOP_KEY = re.compile(r"^[A-Za-z][A-Za-z0-9_-]*:")
EXISTING_DESC_SUFFIX = re.compile(
    r"\s*\|\s*(?:recommendedRole:\s*[a-z0-9-]+(?:\s*\|\s*aliases:\s*[^|]+)?|"
    r"aliases:\s*[^|]+)\.?\s*$"
)


def metadata_description_suffix(role: str | None, aliases: str | None) -> str:
    parts = []
    if role:
        parts.append(f"recommendedRole: {role}")
    if aliases:
        parts.append(f"aliases: {aliases}")
    if not parts:
        return ""
    return " | " + " | ".join(parts) + "."


def extract_description(fm_lines: list[str]) -> str:
    for index, line in enumerate(fm_lines):
        if not line.startswith("description:"):
            continue
        rest = line.split(":", 1)[1].strip()
        if rest in {">", ">-", "|", "|-"}:
            collected = []
            for nxt in fm_lines[index + 1 :]:
                if TOP_KEY.match(nxt) and not nxt.startswith((" ", "\t")):
                    break
                collected.append(nxt.strip())
            return " ".join(item for item in collected if item)
        if len(rest) >= 2 and rest[0] == rest[-1] and rest[0] in {'"', "'"}:
            return rest[1:-1]
        return rest
    return ""


def parse_frontmatter(path: Path) -> dict[str, Any]:
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0] != "---":
        return {}
    result: dict[str, Any] = {}
    metadata_lines: list[str] = []
    fm_lines: list[str] = []
    in_metadata = False
    for line in lines[1:]:
        if line == "---":
            break
        fm_lines.append(line)
        if re.match(r"^[A-Za-z][A-Za-z0-9_-]*:", line):
            in_metadata = line.startswith("metadata:")
            key, value = line.split(":", 1)
            result[key] = value.strip().strip("'\"")
        elif in_metadata:
            metadata_lines.append(line)
            stripped = line.strip()
            if stripped.startswith("recommendedRole:"):
                result["recommendedRole"] = stripped.split(":", 1)[1].strip()
            elif stripped.startswith("aliases:"):
                result["aliases"] = stripped.split(":", 1)[1].strip()
    result["metadata_text"] = "\n".join(metadata_lines)
    result["description"] = extract_description(fm_lines)
    return result


def is_alias_bound_symlink(entry: Path) -> bool:
    if not entry.is_symlink():
        return False
    skill = entry / "SKILL.md"
    if not skill.exists():
        return False
    name = parse_frontmatter(skill).get("name")
    return bool(name) and name != entry.name


def alias_bound_symlinks(root: Path) -> list[str]:
    if not root.is_dir():
        return []
    return sorted(entry.name for entry in root.iterdir() if is_alias_bound_symlink(entry))


def description_suffix_ok(data: dict[str, Any]) -> bool:
    role = data.get("recommendedRole") or None
    aliases = data.get("aliases") or None
    expected = metadata_description_suffix(role, aliases)
    description = (data.get("description") or "").rstrip()
    if not expected:
        return EXISTING_DESC_SUFFIX.search(description) is None
    return description.endswith(expected)


def public_nvidia_auth(path: Path) -> dict[str, Any]:
    raw = agentctl_jira.load_yaml_map(path)
    key = (
        raw.get("api_key")
        or raw.get("nvidia_inference_key")
        or raw.get("NVIDIA_INFERENCE_KEY")
        or ""
    ).strip()
    expires = raw.get("expires_at") or ""
    expired = False
    if expires:
        try:
            expired = dt.date.fromisoformat(expires[:10]) < dt.datetime.now(dt.timezone.utc).date()
        except ValueError:
            expired = False
    return {
        "path": str(path),
        "user": raw.get("user") or None,
        "key_name": raw.get("key_name") or None,
        "created_at": raw.get("created_at") or None,
        "expires_at": expires or None,
        "expired": expired,
        "key_present": bool(key),
        "world_readable": oct(path.stat().st_mode & 0o777) in {"0o644", "0o664", "0o666", "0o755"},
    }


def cmd_skills_scan(args: argparse.Namespace) -> int:
    script = agents_home() / "skills" / "skillspector" / "scripts" / "scan.py"
    timeout = args.timeout or (600 if args.llm else 180)
    script_args = [args.target, "--max-issues", str(args.max_issues), "--timeout", str(timeout)]
    if args.llm:
        script_args.append("--llm")
    if args.recursive:
        script_args.append("--recursive")
    if args.output:
        script_args += ["--output", str(args.output.expanduser().resolve())]
    if args.baseline:
        script_args += ["--baseline", str(args.baseline.expanduser().resolve())]
    return run_skill_script(script, script_args, timeout=timeout + 30)


def cmd_skills_audit(args: argparse.Namespace) -> int:
    roots = [path.resolve() for path in args.root]
    unique: dict[str, dict[str, Any]] = {}
    leftover_aliases: list[str] = []
    for root in roots:
        leftover_aliases.extend(f"{root}/{name}" for name in alias_bound_symlinks(root))
        if not root.is_dir():
            continue
        for path in root.glob("*/SKILL.md"):
            real = path.resolve()
            key = str(real)
            if key in unique:
                unique[key]["entries"].append(str(path))
                continue
            data = parse_frontmatter(real)
            metadata_text = data.get("metadata_text", "")
            required_match = re.search(r"required:\s*\[([^]]*)\]", metadata_text)
            required_dependencies = []
            if required_match:
                required_dependencies = [
                    value.strip().strip("'\"")
                    for value in required_match.group(1).split(",")
                    if value.strip()
                ]
            unique[key] = {
                "name": data.get("name"),
                "path": key,
                "entries": [str(path)],
                "recommended_role": data.get("recommendedRole") or None,
                "aliases": data.get("aliases") or None,
                "description_suffix_ok": description_suffix_ok(data),
                "disable_model_invocation": data.get("disable-model-invocation") == "true",
                "has_dependency_metadata": "cliDependencies:" in metadata_text,
                "required_dependencies": required_dependencies,
                "missing_required_dependencies": [
                    value for value in required_dependencies if not shutil.which(value)
                ],
                "codex_policy": None,
            }
            policy = real.parent / "agents" / "openai.yaml"
            if policy.is_file():
                policy_text = policy.read_text(encoding="utf-8")
                unique[key]["codex_policy"] = "allow_implicit_invocation: false" in policy_text
    vendor_status: dict[str, Any] = {}
    for vendor in args.vendor:
        vendor_root = vendor.resolve()
        leftover_aliases.extend(
            f"{vendor_root}/{name}" for name in alias_bound_symlinks(vendor_root)
        )
        missing = []
        divergent = []
        suffix_mismatches = []
        for path in vendor_root.glob("*/SKILL.md") if vendor_root.is_dir() else []:
            data = parse_frontmatter(path.resolve())
            if not description_suffix_ok(data):
                suffix_mismatches.append(data.get("name") or path.parent.name)
        for item in unique.values():
            name = item["name"]
            candidate = vendor_root / str(name) / "SKILL.md"
            if not candidate.exists():
                missing.append(name)
            elif candidate.resolve() != Path(item["path"]):
                divergent.append(name)
        vendor_status[str(vendor_root)] = {
            "missing": sorted(missing),
            "divergent": sorted(divergent),
            "description_suffix_mismatches": sorted(set(suffix_mismatches)),
        }
    items = sorted(unique.values(), key=lambda item: str(item["name"]))
    suffix_mismatches = sorted(
        str(item["name"]) for item in items if not item["description_suffix_ok"]
    )
    declared_aliases = sum(
        len([part for part in (item["aliases"] or "").split(",") if part.strip()])
        for item in items
    )
    leftover_aliases = sorted(set(leftover_aliases))
    emit({
        "unique_skills": len(items),
        "alias_entries": len(leftover_aliases),
        "alias_bound_symlinks": leftover_aliases,
        "declared_aliases": declared_aliases,
        "description_suffix_mismatches": suffix_mismatches,
        "manual_only_frontmatter": sum(1 for item in items if item["disable_model_invocation"]),
        "manual_only_codex": sum(1 for item in items if item["codex_policy"]),
        "with_dependency_metadata": sum(1 for item in items if item["has_dependency_metadata"]),
        "missing_required_dependencies": sorted({
            value for item in items for value in item["missing_required_dependencies"]
        }),
        "vendors": vendor_status,
        "skills": items,
    })
    return 2 if leftover_aliases or suffix_mismatches else 0


def ollama_models() -> list[dict[str, str]]:
    ollama = shutil.which("ollama")
    if not ollama:
        return []
    result = run([ollama, "list"])
    models = []
    for line in result.stdout.splitlines()[1:]:
        parts = line.split()
        if parts:
            models.append({"name": parts[0], "id": parts[1] if len(parts) > 1 else ""})
    return models


def cmd_local_models(args: argparse.Namespace) -> int:
    models = ollama_models()
    emit({"available": bool(shutil.which("ollama")), "models": models})
    return 0


def cmd_local_run(args: argparse.Namespace) -> int:
    ollama = shutil.which("ollama")
    if not ollama:
        emit({"status": "ollama-missing"})
        return 2
    if args.file:
        content = args.file.read_text(encoding="utf-8", errors="replace")
    elif args.text is not None:
        content = args.text
    else:
        content = sys.stdin.read()
    content = content[: argsafe_limit(args.max_chars)]
    prompt = f"{args.instruction.strip()}\n\nINPUT:\n{content}"
    result = run([ollama, "run", args.model], input_text=prompt)
    clean_stderr = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", result.stderr)
    emit({"status": "ok" if result.returncode == 0 else "error", "model": args.model,
          "input_chars": len(content), "output": result.stdout[: argsafe_limit(args.max_output_chars)],
          "stderr": clean_stderr[:1000] if result.returncode else "", "exit_code": result.returncode})
    return result.returncode


def cmd_docs_index(args: argparse.Namespace) -> int:
    database = args.db.expanduser().resolve()
    database.parent.mkdir(parents=True, exist_ok=True)
    roots = [path.expanduser().resolve() for path in args.root]
    documents: list[tuple[str, str, str]] = []
    for root in roots:
        if not root.is_dir():
            continue
        for path in sorted(root.rglob("*.md")):
            if path.name == "llm-index.md":
                continue
            body = path.read_text(encoding="utf-8", errors="replace")
            title = next(
                (line.lstrip("#").strip() for line in body.splitlines() if line.startswith("#")),
                path.stem,
            )
            documents.append((str(path), title, body))
    connection = sqlite3.connect(database)
    try:
        connection.execute("DROP TABLE IF EXISTS docs")
        connection.execute(
            "CREATE VIRTUAL TABLE docs USING fts5("
            "path UNINDEXED, title, body, tokenize='unicode61 remove_diacritics 2')"
        )
        connection.executemany("INSERT INTO docs(path, title, body) VALUES (?, ?, ?)", documents)
        connection.commit()
        optimize_error = None
        try:
            connection.execute("INSERT INTO docs(docs) VALUES ('optimize')")
        except sqlite3.DatabaseError as exc:
            optimize_error = str(exc)
    finally:
        connection.close()
    emit({"status": "indexed", "database": str(database), "roots": [str(path) for path in roots],
          "documents": len(documents), "optimize_error": optimize_error})
    return 0


def cmd_docs_search(args: argparse.Namespace) -> int:
    database = args.db.expanduser().resolve()
    if not database.is_file():
        emit({"status": "missing-index", "database": str(database)})
        return 2
    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    connection.row_factory = sqlite3.Row
    tokens = re.findall(r"[\w.]+", args.query, re.UNICODE)
    fts_query = args.query if args.raw_fts else " ".join(f'"{token}"' for token in tokens)
    if not fts_query:
        emit({"status": "query-error", "database": str(database), "error": "empty query"})
        return 2
    try:
        rows = connection.execute(
            "SELECT path, title, snippet(docs, 2, '[', ']', ' … ', 24) AS snippet, "
            "bm25(docs, 0.0, 2.0, 1.0) AS score FROM docs WHERE docs MATCH ? "
            "ORDER BY score LIMIT ?",
            (fts_query, args.limit),
        ).fetchall()
    except sqlite3.DatabaseError as exc:
        emit({"status": "query-error", "database": str(database), "error": str(exc)})
        return 2
    finally:
        connection.close()
    emit({"status": "ok", "database": str(database), "query": args.query,
          "fts_query": fts_query,
          "count": len(rows), "results": [dict(row) for row in rows]})
    return 0


def _help_action(parser: argparse.ArgumentParser):
    """Default action for a group: print that group's own help, exit 0 (D16)."""
    def run(_args: argparse.Namespace) -> int:
        parser.print_help()
        return 0
    return run


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agentctl",
        description=(
            "Deterministic local primitives for agent workflows.\n\n"
            "agentctl keeps mechanical discovery, extraction, validation, and indexing "
            "off the model path. Commands emit bounded JSON so an agent can inspect a "
            "small result and open only the source artifacts it actually needs."
        ),
        epilog=(
            "Common examples:\n"
            "  agentctl repo detect --cwd .\n"
            "  agentctl delivery scope --cwd . --write-diff /tmp/delivery.patch\n"
            "  agentctl logs extract server.log --limit 20\n"
            "  agentctl evidence inspect screenshot.png --ocr --expected-text 'Saved'\n"
            "  agentctl jira fetch PROJ-1\n"
            "  agentctl playwright spawn JOT-101 --enable\n"
            "  agentctl playwright revive --default\n"
            "  agentctl security detect --cwd .\n"
            "  agentctl security scan --check secrets,deps --fail-on HIGH\n"
            "  agentctl skills scan ~/.agents/skills/find-skills\n"
            "  agentctl tools audit --versions\n\n"
            "Run 'agentctl GROUP --help' or 'agentctl GROUP COMMAND --help' for details."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    top = parser.add_subparsers(
        dest="group", required=False, title="command groups", metavar="GROUP"
    )

    def group(name: str, summary: str) -> argparse._SubParsersAction:
        group_parser = top.add_parser(
            name,
            help=summary,
            description=summary,
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        group_parser.set_defaults(func=_help_action(group_parser))
        return group_parser.add_subparsers(
            dest="action", required=False, title="commands", metavar="COMMAND"
        )

    task = group("task", "Resolve issue keys, kebab slugs, and task context from local inputs.")
    resolve = task.add_parser(
        "resolve",
        help="Resolve a task key from text, branch, or local files.",
        description=(
            "Resolve a Jira issue key or local kebab slug from explicit text and "
            "repository context. Text beats branch, cwd, and filename scans. "
            "Returns candidates, selected key, and mode (jira|local) as JSON."
        ),
    )
    resolve.add_argument("--cwd", type=Path, default=Path.cwd(), help="Repository or task directory.")
    resolve.add_argument("--text", default="", help="Prompt text or URL that may contain an issue key.")
    resolve.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    resolve.set_defaults(func=cmd_task_resolve)

    markdown = group("markdown", "Select named Markdown sections without loading the whole file.")
    slice_parser = markdown.add_parser(
        "slice",
        help="Return selected heading sections.",
        description="Extract selected Markdown sections and return bounded JSON.",
    )
    slice_parser.add_argument("file", type=Path, help="Markdown file to inspect.")
    slice_parser.add_argument(
        "--sections", required=True, help="Comma-separated heading names, case-insensitive."
    )
    slice_parser.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    slice_parser.set_defaults(func=cmd_markdown_slice)

    delivery = group("delivery", "Identify the current local delivery and its changed files.")
    scope = delivery.add_parser(
        "scope",
        help="Summarize the current delivery diff.",
        description=(
            "Inspect staged, unstaged, or branch changes without modifying git state. "
            "Optionally persist the full diff and return only its path and summary."
        ),
    )
    scope.add_argument("--cwd", type=Path, default=Path.cwd(), help="Git repository directory.")
    scope.add_argument("--base", help="Explicit base revision for branch-diff mode.")
    scope.add_argument("--write-diff", type=Path, help="Write the full diff to this path.")
    scope.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    scope.set_defaults(func=cmd_delivery_scope)

    repo = group("repo", "Detect repository stacks, manifests, and project-native checks.")
    detect = repo.add_parser(
        "detect",
        help="Detect repository structure and technology stacks.",
        description="Inspect local manifests and return stack/check hints without running builds.",
    )
    detect.add_argument("--cwd", type=Path, default=Path.cwd(), help="Repository directory.")
    detect.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    detect.set_defaults(func=cmd_repo_detect)

    plan = group("plan", "Create, resolve, and validate structured implementation or evidence plans.")
    init = plan.add_parser(
        "init",
        help="Create a deterministic plan skeleton.",
        description=(
            "Create the required headings for a plan without inventing plan content. "
            "A path that does not end in .md is a folder layout (plan.md plus companions). "
            "A .md path stays a single-file plan."
        ),
    )
    init.add_argument("--kind", choices=sorted(PLAN_HEADINGS), required=True, help="Plan schema.")
    init.add_argument("--issue", required=True, help="Issue key used in the plan title.")
    init.add_argument("--output", type=Path, required=True, help="Destination Markdown file or plan directory.")
    init.add_argument("--force", action="store_true", help="Replace an existing output file.")
    init.set_defaults(func=cmd_plan_init)
    validate = plan.add_parser(
        "validate",
        help="Check required plan structure.",
        description=(
            "Report missing required sections without editing the plan. "
            "Accepts a single Markdown file or a plan folder."
        ),
    )
    validate.add_argument("file", type=Path, help="Plan Markdown file or plan directory.")
    validate.add_argument(
        "--kind",
        choices=sorted(PLAN_HEADINGS),
        help="Plan schema. Inferred from layout or filename when omitted.",
    )
    validate.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    validate.set_defaults(func=cmd_plan_validate)
    progress = plan.add_parser(
        "progress",
        help="Read or record per-step progress so a re-run skips finished work.",
        description=(
            "Report which plan steps are done, which are pending, and which step is "
            "next. With no progress file the state is INFERRED from the plan's "
            "'Already delivered' ledger, inline [x]/DONE step marks, and (evidence "
            "plans) artifacts already on disk, so plans written before this command "
            "resume correctly. A folder plan stores implementation progress in "
            "progress.md and every other kind in <kind>.progress.md (evidence: "
            "evidence.progress.md), so kinds never overwrite each other; a legacy "
            "progress.md is still read for the kind it records. A single-file plan "
            "stores <stem>.progress.md beside it, so files that share a directory do "
            "not share state. All are excluded from validation. next is the first "
            "step that is not done or skipped, so a blocked step stays next."
        ),
    )
    progress.add_argument("target", help="Issue key, plan folder, or plan file path.")
    progress.add_argument(
        "--kind",
        choices=sorted(PLAN_HEADINGS),
        help="Plan schema. Inferred from layout or filename when omitted.",
    )
    progress.add_argument(
        "--set",
        action="append",
        metavar="ID=STATUS",
        help=f"Record a step, e.g. S3=done. Status one of {', '.join(PROGRESS_STATUSES)}. Implies --write.",
    )
    progress.add_argument("--note", help="Short note stored with the --set steps.")
    progress.add_argument("--write", action="store_true",
                          help="Materialise the progress file from the current state.")
    progress.add_argument("--reset", action="store_true",
                          help="Delete the progress file. State falls back to inference.")
    progress.add_argument("--artifacts-dir", type=Path,
                          help="Evidence artifacts dir. Defaults to ~/.agents/prds/<TASK-ID>/evidence.")
    progress.add_argument(
        "--plans-dir", type=Path, default=PLANS_ROOT,
        help="Plans root. Defaults to ~/.agents/plans.",
    )
    progress.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    progress.set_defaults(func=cmd_plan_progress)
    migrate = plan.add_parser(
        "migrate",
        help="Add required sections a plan predates, without touching its content.",
        description=(
            "Report (default) or insert (--apply) required headings an older plan "
            "lacks. Only appends an empty stub; never rewrites existing sections."
        ),
    )
    migrate.add_argument("file", type=Path, help="Plan Markdown file or plan directory.")
    migrate.add_argument(
        "--kind",
        choices=sorted(PLAN_HEADINGS),
        help="Plan schema. Inferred from layout or filename when omitted.",
    )
    migrate.add_argument("--apply", action="store_true",
                         help="Write the stub sections. Default is a dry run.")
    migrate.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    migrate.set_defaults(func=cmd_plan_migrate)
    plan_resolve = plan.add_parser(
        "resolve",
        help="Resolve a task id to plan entry, kind, and section index.",
        description=(
            "Look up ~/.agents/plans/{TASK-ID}/ first, then {TASK-ID}.md and "
            "{TASK-ID}-evidence-plan.md. Return bounded JSON: entry, kind, sections."
        ),
    )
    plan_resolve.add_argument("task_id", help="Issue key, plan folder, or plan file path.")
    plan_resolve.add_argument(
        "--kind",
        choices=sorted(PLAN_HEADINGS),
        help="Prefer implementation or evidence when both exist.",
    )
    plan_resolve.add_argument(
        "--plans-dir",
        type=Path,
        default=PLANS_ROOT,
        help="Plans root. Defaults to ~/.agents/plans.",
    )
    plan_resolve.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    plan_resolve.set_defaults(func=cmd_plan_resolve)

    logs = group("logs", "Extract and deduplicate important local log events.")
    extract = logs.add_parser(
        "extract",
        help="Return bounded error and warning blocks.",
        description=(
            "Extract selected log levels, retain attached stack lines, deduplicate volatile "
