FROM ubuntu:24.04

# Instalar dependências e bibliotecas do Wayland
RUN apt-get update && apt-get install -y \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libgtk-3-0 libgbm1 libasound2t64 wget fuse3 \
    libwayland-client0 libwayland-egl1 libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 developer
USER developer
WORKDIR /home/developer

CMD ["/home/developer/cursor-app/Cursor", "--no-sandbox", "--enable-features=UseOzonePlatform", "--ozone-platform=wayland"]

