[Desktop Entry]
# Identity-fork launcher for profile ${PROFILE_NAME}.
# Generated by devkit; edits are lost on `devkit profile sync`.
Type=Application
Name=Cursor · ${PROFILE_NAME}
GenericName=The AI Code Editor (${PROFILE_NAME})
Comment=Cursor running the ${PROFILE_NAME} harness profile
Exec=${PROFILE_AUTH_LAUNCH} --vendor cursor --profile ${PROFILE_NAME} -- ${PROFILE_GUI_BIN} --user-data-dir=${PROFILE_CONFIG_DIR} --extensions-dir=${PROFILE_DATA_DIR}/extensions %F
Icon=${PROFILE_ICON_NAME}
Terminal=false
Categories=TextEditor;Development;IDE;
Keywords=cursor;Code;Editor;AI;
StartupNotify=false
StartupWMClass=${PROFILE_WM_CLASS}
MimeType=application/x-cursor-workspace;
Actions=new-empty-window;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=${PROFILE_AUTH_LAUNCH} --vendor cursor --profile ${PROFILE_NAME} -- ${PROFILE_GUI_BIN} --user-data-dir=${PROFILE_CONFIG_DIR} --extensions-dir=${PROFILE_DATA_DIR}/extensions --new-window %F
