# Copy to the paths below. Never put values in ~/.agents/mcp.

# GitLab is not an env file. Wrapper ~/.agents/bin/gitlab-mcp reads
# $AGENTS_HOME/.auth/gitlab-access-token.yaml
# (access_token, gitlab_url). Mode 600. Do not put the PAT in mcp.json.

# ~/.browser-control-mcp.env
EXTENSION_SECRET=
EXTENSION_PORT=8089

# Export in the shell (or a file you source) before Claude/Codex Slack register:
# SLACK_MCP_CLIENT_ID=
# SLACK_MCP_TOKEN=
