{
  "_comment": [
    "Claude Code settings for one profile instance.",
    "${PROFILE_*} and ${HOME} are rendered by install.py; nothing here is read raw.",
    "This file is rendered whole into the profile's settings.json on every sync;",
    "bin/merge-claude-config.py merges the user .claude.json, not this file."
  ],
  "includeCoAuthoredBy": false,
  "attribution": { "coAuthoredBy": false, "generatedWith": false },
  "env": { "CLAUDE_CODE_TMPDIR": "/var/tmp" },
  "claudeMdExcludes": [
    "${HOME}/.claude/rules/**"
  ],
  "permissions": {
    "additionalDirectories": [
      "${PROFILE_AGENTS_HOME}",
      "${PROFILE_CONFIG_DIR}"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${PROFILE_HARNESS_DIR}/hooks/profile-statusline.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PROFILE_HARNESS_DIR}/hooks/claude-history-adapter.py prompt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PROFILE_HARNESS_DIR}/hooks/kb-router.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PROFILE_HARNESS_DIR}/hooks/claude-history-adapter.py stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PROFILE_HARNESS_DIR}/hooks/response-format-check.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PROFILE_HARNESS_DIR}/hooks/claude-git-guard.py"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(addOrEditJiraIssueComment|addCommentToJiraIssue|uploadAttachmentToJiraIssue|jira_add_comment|jira_update_comment|jira_prepare_upload|executeWrite)",
        "hooks": [
          {
            "type": "command",
            "command": "${PROFILE_HARNESS_DIR}/hooks/jira-write-guard.py"
          }
        ]
      }
    ]
  }
}
