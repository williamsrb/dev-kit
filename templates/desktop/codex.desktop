[Desktop Entry]
# Identity-fork launcher for profile ${PROFILE_NAME}.
# Generated by devkit; edits are lost on `devkit profile sync`.
Type=Application
Name=Codex · ${PROFILE_NAME}
GenericName=AI Coding Assistant (${PROFILE_NAME})
Comment=ChatGPT Desktop (Codex) running the ${PROFILE_NAME} harness profile
Exec=${PROFILE_AUTH_LAUNCH} --vendor codex --profile ${PROFILE_NAME} -- env CODEX_HOME=${PROFILE_CONFIG_DIR} CODEX_ELECTRON_USER_DATA_PATH=${PROFILE_USER_DATA_DIR} ${PROFILE_GUI_BIN} %U
Icon=${PROFILE_ICON_NAME}
Terminal=false
Categories=Development;IDE;
Keywords=AI;Chat;Assistant;ChatGPT;Codex;LLM;
StartupNotify=true
StartupWMClass=${PROFILE_WM_CLASS}
SingleMainWindow=true
