{
  "comment": "User-level MCP servers extracted from the Cursor, Claude, and Codex config dirs. No secrets. Paths use ${HOME}.",
  "vendors": {
    "cursor": {
      "home": "${HOME}/.cursor"
    },
    "claude": {
      "home": "${HOME}/.claude",
      "claude_config_dir": "${HOME}/.claude"
    },
    "codex": {
      "home": "${HOME}/.codex"
    }
  },
  "env_files": {
    "gitlab": "${HOME}/.gitlab-mcp-server.env",
    "browser_control": "${HOME}/.browser-control-mcp.env"
  },
  "servers": {
    "context7": {
      "transport": "http",
      "url": "https://mcp.context7.com/mcp",
      "auth": "oauth",
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": null
    },
    "atlassian-rovo-preview": {
      "transport": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/preview",
      "auth": "oauth",
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": null
    },
    "gitlab": {
      "transport": "stdio",
      "command": "${HOME}/.local/bin/gitlab-mcp-server",
      "args": [],
      "env_file": "gitlab",
      "env_keys": [
        "GITLAB_URL",
        "GITLAB_TOKEN"
      ],
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": "gitlab-mcp-server"
    },
    "browser-control": {
      "transport": "stdio",
      "command": "node",
      "args": [
        "${HOME}/.local/src/browser-control-mcp/mcp-server/dist/server.js"
      ],
      "env_file": "browser_control",
      "env_keys": [
        "EXTENSION_SECRET",
        "EXTENSION_PORT"
      ],
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": "browser-control-mcp"
    },
    "slack-workspace-leanon": {
      "transport": "http",
      "url": "https://mcp.slack.com/mcp?ws=leanon",
      "auth": "slack",
      "oauth_client_id_env": "SLACK_MCP_CLIENT_ID",
      "bearer_env": "SLACK_MCP_TOKEN",
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "vendor_overrides": {
        "codex": {
          "url": "https://mcp.slack.com/mcp"
        }
      },
      "fetch": null
    },
    "playwright": {
      "transport": "http",
      "url": "http://localhost:8931/mcp",
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": "playwright-mcp",
      "comment": "Parked. Spawn isolated HTTP instances with mcp/playwright.py; do not register this stub."
    },
    "image-to-disk": {
      "transport": "stdio",
      "command": "python3",
      "args": [
        "${HOME}/.agents/mcp/image-to-disk/server.py"
      ],
      "vendors": [
        "claude"
      ],
      "fetch": null
    },
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}/.agents",
        "${HOME}/.cursor",
        "${HOME}/.codex",
        "${HOME}/.claude",
        "${HOME}/.config/Codex",
        "${HOME}/.config/Claude"
      ],
      "vendors": [
        "claude"
      ],
      "fetch": "filesystem-mcp"
    },
    "graft": {
      "transport": "stdio",
      "command": "graft",
      "args": [
        "mcp"
      ],
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": null
    },
    "serena": {
      "transport": "stdio",
      "command": "${HOME}/.local/bin/serena",
      "args": [
        "start-mcp-server",
        "--project-from-cwd",
        "--context=ide"
      ],
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "vendor_overrides": {
        "claude": {
          "args": [
            "start-mcp-server",
            "--project-from-cwd",
            "--context=claude-code"
          ]
        },
        "codex": {
          "args": [
            "start-mcp-server",
            "--project-from-cwd",
            "--context=codex"
          ]
        }
      },
      "fetch": "serena-agent"
    }
  },
  "skip": {
    "node_repl": "Codex Desktop bundled binary under /opt/codex-desktop; not a user-installable MCP."
  },
  "parked": {
    "slack-workspace-leanon": "generate-worklogs only; snippets in ${HOME}/.agents/.auth/mcp-on-demand/",
    "graft": "CLI + graft.mdc are the default; MCP is optional",
    "playwright": "on-demand HTTP via mcp/playwright.py; one process and output-dir per id. Do not register this stub.",
    "browser-control": "on-demand; snippets in ${HOME}/.agents/.auth/mcp-on-demand/"
  },
  "plugins_not_user_mcp": {
    "comment": "Marketplace plugins that also expose MCP tools. Installed via each vendor's plugin UI/CLI, not mcp add.",
    "atlassian@claude-plugins-official": [
      "claude",
      "codex"
    ],
    "slack@claude-plugins-official": [
      "claude",
      "codex"
    ]
  },
  "fetch": {
    "gitlab-mcp-server": {
      "version": "2.6.2",
      "dest": "${HOME}/.local/bin/gitlab-mcp-server",
      "url": "https://github.com/jmrplens/gitlab-mcp-server/releases/download/v2.6.2/gitlab-mcp-server-linux-amd64"
    },
    "browser-control-mcp": {
      "repo": "https://github.com/eyalzh/browser-control-mcp.git",
      "dest": "${HOME}/.local/src/browser-control-mcp",
      "build": [
        "npm",
        "install"
      ]
    },
    "playwright-mcp": {
      "npx_package": "@playwright/mcp@latest"
    },
    "filesystem-mcp": {
      "npx_package": "@modelcontextprotocol/server-filesystem"
    },
    "serena-agent": {
      "uv_tool": "serena-agent",
      "python": "3.13"
    }
  }
}
