def main() -> int:
    parser = build_parser()
    args, unknown = parser.parse_known_args()
    if not hasattr(args, "func"):
        if unknown:
            parser.error("unrecognized arguments: " + " ".join(unknown))
        parser.print_help()
        return 0
    if args.func is cmd_playwright:
        extra = list(getattr(args, "playwright_args", None) or [])
        args.playwright_args = extra + unknown
        unknown = []
    if unknown:
        parser.error("unrecognized arguments: " + " ".join(unknown))
    try:
        return int(args.func(args))
    except (OSError, ValueError, subprocess.SubprocessError, agentctl_jira.JiraError) as exc:
        emit({"status": "error", "error": str(exc), "type": type(exc).__name__})
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
