[Desktop Entry]
# Identity-fork launcher for profile ${PROFILE_NAME}.
# Generated by devkit; edits are lost on `devkit profile sync`.
Type=Application
Name=Claude · ${PROFILE_NAME}
GenericName=AI Coding Assistant (${PROFILE_NAME})
Comment=Claude Desktop running the ${PROFILE_NAME} harness profile
Exec=${PROFILE_AUTH_LAUNCH} --vendor claude --profile ${PROFILE_NAME} -- env CLAUDE_CONFIG_DIR=${PROFILE_CONFIG_DIR} ${PROFILE_GUI_BIN} --user-data-dir=${PROFILE_USER_DATA_DIR} %U
Icon=${PROFILE_ICON_NAME}
Terminal=false
Categories=Development;IDE;
Keywords=AI;Chat;Assistant;Claude;Code;LLM;
StartupNotify=true
StartupWMClass=${PROFILE_WM_CLASS}
SingleMainWindow=true
Actions=NewChat;NewCode;

[Desktop Action NewChat]
Name=New Chat
Exec=${PROFILE_AUTH_LAUNCH} --vendor claude --profile ${PROFILE_NAME} -- env CLAUDE_CONFIG_DIR=${PROFILE_CONFIG_DIR} ${PROFILE_GUI_BIN} --user-data-dir=${PROFILE_USER_DATA_DIR} claude://claude.ai/new

[Desktop Action NewCode]
Name=New Claude Code Session
Exec=${PROFILE_AUTH_LAUNCH} --vendor claude --profile ${PROFILE_NAME} -- env CLAUDE_CONFIG_DIR=${PROFILE_CONFIG_DIR} ${PROFILE_GUI_BIN} --user-data-dir=${PROFILE_USER_DATA_DIR} claude://code/new
