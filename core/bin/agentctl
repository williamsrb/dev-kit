#!/usr/bin/env python3
"""Deterministic local primitives for personal agent skills.

Keep raw artifacts on disk and return compact JSON for model-facing workflows.
Python 3.12+, standard library only; optional capabilities call declared CLIs.
Heavy groups live in bin/agentctl_<name>.py. This file registers them.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import re
import shutil
import sqlite3
import subprocess
import sys
from pathlib import Path
from typing import Any

_BIN_DIR = Path(__file__).resolve().parent
if str(_BIN_DIR) not in sys.path:
    sys.path.insert(0, str(_BIN_DIR))
import agentctl_docs
import agentctl_image
import agentctl_jira
import agentctl_kb
import agentctl_plan
import agentctl_security
import agentctl_skills
from agentctl_common import (
    agents_home,
    argsafe_limit,
    emit,
    git,
    markdown_sections,
    repo_root,
    run,
    section_slug,
)
from agentctl_skills import public_nvidia_auth

ISSUE_RE = re.compile(r"(?<![A-Z0-9])([A-Z][A-Z0-9]+-\d+)(?![A-Z0-9])", re.IGNORECASE)
SLUG_RE = re.compile(r"(?<![A-Za-z0-9-])([a-z][a-z0-9]*(?:-[a-z0-9]+)+)(?![A-Za-z0-9-])")
LOG_START_RE = re.compile(
    r"^(?:\d{4}-\d{2}-\d{2}[T ][^ ]+\s+)?(?:\[[^]]+\]\s*)?"
    r"(?P<level>ERROR|WARN(?:ING)?|FATAL)\b",
    re.IGNORECASE,
)
TIMESTAMP_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[T ][0-9:.+\-Z]+")

RECOMMENDED_TOOLS = (
    "rg", "jq", "git", "python3", "php", "xmllint", "xmlstarlet", "yq",
    "shellcheck", "shfmt", "ruff", "markdownlint-cli2", "lychee",
    "codespell", "ast-grep", "gitleaks", "osv-scanner", "trivy", "semgrep",
    "qpdf", "ocrmypdf", "tesseract", "image-diff", "convert", "identify", "pdftotext",
    "pdfinfo", "pdftoppm", "ffmpeg", "ffprobe", "libreoffice", "zstd",
    "ollama", "skillspector",
)

RECOMMENDED_PYTHON_PACKAGES = ("PIL", "numpy")

def _is_jira_token(token: str) -> bool:
    match = ISSUE_RE.search(token)
    return bool(match) and match.group(1).lower() == token.lower()


def _local_artifact_exists(key: str) -> bool:
    home = agents_home()
    return (
        (home / "prds" / f"{key}.md").is_file()
        or (home / "plans" / key).is_dir()
        or (home / "plans" / f"{key}.md").is_file()
    )


def _unique(items: list[dict[str, str]]) -> list[dict[str, str]]:
    seen: set[str] = set()
    unique: list[dict[str, str]] = []
    for item in items:
        if item["key"] in seen:
            continue
        seen.add(item["key"])
        unique.append(item)
    return unique


def _issues_from(source: str, value: str) -> list[dict[str, str]]:
    found: list[dict[str, str]] = []
    for match in ISSUE_RE.finditer(value):
        found.append({"key": match.group(1).upper(), "source": source, "value": value[:300], "mode": "jira"})
    return _unique(found)


def _slugs_from(source: str, value: str) -> list[dict[str, str]]:
    found: list[dict[str, str]] = []
    for match in SLUG_RE.finditer(value):
        token = match.group(1)
        if _is_jira_token(token):
            continue
        found.append({"key": token, "source": source, "value": value[:300], "mode": "local"})
    found = _unique(found)
    if len(found) <= 1:
        return found
    existing = [item for item in found if _local_artifact_exists(item["key"])]
    return existing or found


def cmd_task_resolve(args: argparse.Namespace) -> int:
    cwd = args.cwd.resolve()
    root = repo_root(cwd)
    branch = git(root, "branch", "--show-current").stdout.strip() if root else ""
    file_issues: list[dict[str, str]] = []
    for folder_name in ("plans", "prds"):
        for base in (cwd, agents_home()):
            folder = base / folder_name
            if folder.is_dir():
                for item in sorted(folder.glob("*.md"), key=lambda p: p.stat().st_mtime, reverse=True)[:20]:
                    file_issues.extend(_issues_from(f"{folder_name}-filename", item.name))
    file_issues = _unique(file_issues)

    buckets = (
        _issues_from("text", args.text) if args.text else [],
        _slugs_from("text", args.text) if args.text else [],
        _issues_from("git-branch", branch) if branch else [],
        _slugs_from("git-branch", branch) if branch else [],
        _issues_from("cwd", cwd.name),
        _slugs_from("cwd", cwd.name),
        file_issues,
    )
    candidates: list[dict[str, str]] = []
    for bucket in buckets:
        if bucket:
            candidates = bucket
            break
    status = "resolved" if len(candidates) == 1 else "ambiguous" if candidates else "unresolved"
    selected = candidates[0] if len(candidates) == 1 else None
    emit({
        "status": status,
        "key": selected["key"] if selected else None,
        "mode": selected["mode"] if selected else None,
        "candidates": candidates,
        "repo": str(root) if root else None,
    })
    return 0 if status == "resolved" else 2


def cmd_markdown_slice(args: argparse.Namespace) -> int:
    wanted = {section_slug(value) for value in args.sections.split(",") if value.strip()}
    selected = [section for section in markdown_sections(args.file)
                if wanted.intersection(section["slugs"])]
    payload = {
        "file": str(args.file.resolve()),
        "requested": sorted(wanted),
        "found": [section["slug"] for section in selected],
        "missing": sorted(wanted - {slug for section in selected for slug in section["slugs"]}),
        "sections": selected,
    }
    emit(payload, as_json=args.json)
    return 0 if not payload["missing"] else 2


def cmd_delivery_scope(args: argparse.Namespace) -> int:
    cwd = args.cwd.resolve()
    root = repo_root(cwd)
    if not root:
        emit({"status": "not-a-git-repo", "cwd": str(cwd)})
        return 2
    commands = {
        "unstaged": ("diff", "--name-only"),
        "staged": ("diff", "--cached", "--name-only"),
        "untracked": ("ls-files", "--others", "--exclude-standard"),
    }
    files: dict[str, list[str]] = {}
    for label, command in commands.items():
        result = git(root, *command)
        files[label] = [line for line in result.stdout.splitlines() if line]
    branch = git(root, "branch", "--show-current").stdout.strip()
    base = args.base
    branch_files: list[str] = []
    if base:
        result = git(root, "diff", "--name-only", f"{base}...HEAD")
        if result.returncode == 0:
            branch_files = [line for line in result.stdout.splitlines() if line]
    if args.write_diff:
        diff = git(root, "diff", "--binary").stdout
        args.write_diff.parent.mkdir(parents=True, exist_ok=True)
        args.write_diff.write_text(diff, encoding="utf-8")
    emit({"status": "ok", "repo": str(root), "branch": branch, "base": base,
          "files": files, "branch_files": branch_files,
          "diff_file": str(args.write_diff.resolve()) if args.write_diff else None})
    return 0


PROJECT_MARKERS = {
    "node": ("package.json",),
    "python": ("pyproject.toml", "requirements.txt", "setup.py"),
    "php": ("composer.json", "composer.lock"),
    "gradle": ("build.gradle", "build.gradle.kts", "gradlew"),
    "godot": ("project.godot",),
    "enonic": ("app/src/main/resources/application.xml", "src/main/resources/application.xml"),
    "react4xp": ("react4xp.config.js", "react4xp.config.ts"),
    "docker": ("Dockerfile", "compose.yaml", "docker-compose.yml"),
}


def cmd_repo_detect(args: argparse.Namespace) -> int:
    cwd = args.cwd.resolve()
    root = repo_root(cwd) or cwd
    stacks: dict[str, list[str]] = {}
    for stack, markers in PROJECT_MARKERS.items():
        hits = [marker for marker in markers if (root / marker).exists()]
        if hits:
            stacks[stack] = hits
    package_manager = None
    for manager, lockfile in (("pnpm", "pnpm-lock.yaml"), ("yarn", "yarn.lock"),
                              ("npm", "package-lock.json"), ("bun", "bun.lockb")):
        if (root / lockfile).exists():
            package_manager = manager
            break
    emit({"root": str(root), "git": repo_root(cwd) is not None, "stacks": stacks,
          "package_manager": package_manager})
    return 0

def log_events(path: Path, levels: set[str], limit: int) -> list[dict[str, Any]]:
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    blocks: list[tuple[int, list[str], str]] = []
    current: tuple[int, list[str], str] | None = None
    for number, line in enumerate(lines, 1):
        start = LOG_START_RE.search(line)
        if start:
            if current:
                blocks.append(current)
            level = start.group("level").upper().replace("WARNING", "WARN")
            current = (number, [line], level) if level in levels else None
        elif current:
            if TIMESTAMP_RE.match(line) and not re.search(r"\bat\s+", line):
                blocks.append(current)
                current = None
            elif len(current[1]) < 80:
                current[1].append(line)
    if current:
        blocks.append(current)
    seen: set[str] = set()
    events: list[dict[str, Any]] = []
    for line_no, block, level in blocks:
        text = "\n".join(block).strip()
        normalized = re.sub(r"\b\d+\b", "#", text)
        fingerprint = hashlib.sha256(normalized.encode()).hexdigest()[:12]
        if fingerprint in seen:
            continue
        seen.add(fingerprint)
        events.append({"line": line_no, "level": level, "fingerprint": fingerprint,
                       "text": text[: argsafe_limit(8000)]})
        if len(events) >= limit:
            break
    return events



def cmd_logs_extract(args: argparse.Namespace) -> int:
    levels = {value.strip().upper() for value in args.levels.split(",") if value.strip()}
    events = log_events(args.file, levels, args.limit)
    emit({"file": str(args.file.resolve()), "levels": sorted(levels), "count": len(events),
          "truncated": len(events) == args.limit, "events": events})
    return 0

def cmd_playwright(args: argparse.Namespace) -> int:
    script = agents_home() / "mcp" / "playwright.py"
    extra = list(args.playwright_args or [])
    proc = subprocess.run([sys.executable, str(script), args.action, *extra], check=False)
    return proc.returncode


def cmd_worklog_collect(args: argparse.Namespace) -> int:
    day = (
        dt.date.fromisoformat(args.date)
        if args.date
        else dt.datetime.now().astimezone().date()
    )
    history = agents_home() / "history" / day.isoformat()
    prompts = sorted(str(path) for path in history.glob("*_prompt.md")) if history.is_dir() else []
    result: dict[str, Any] = {"date": day.isoformat(), "history": {"count": len(prompts), "files": prompts},
                              "git": [], "collector": None}
    collector = agents_home() / "skills" / "generate-worklogs" / "scripts" / "collect-daily-evidence.py"
    if collector.is_file():
        collected = run([sys.executable, str(collector), day.isoformat()])
        cache_dir = agents_home() / ".cache" / "worklogs"
        cache_dir.mkdir(parents=True, exist_ok=True)
        cache_file = cache_dir / f"{day.isoformat()}.txt"
        cache_file.write_text(collected.stdout, encoding="utf-8")
        result["collector"] = {"exit_code": collected.returncode, "cache": str(cache_file),
                               "bytes": len(collected.stdout.encode())}
        for line in collected.stdout.splitlines():
            if line.startswith("REPO|"):
                parts = line.split("|", 2)
                result["git"].append({"repo": parts[1], "details": parts[2] if len(parts) > 2 else ""})
    database = agents_home() / ".cache" / "worklogs" / "evidence.sqlite"
    database.parent.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(database)
    try:
        connection.execute(
            "CREATE TABLE IF NOT EXISTS daily_evidence ("
            "day TEXT PRIMARY KEY, payload TEXT NOT NULL, updated_at TEXT NOT NULL)"
        )
        connection.execute(
            "INSERT OR REPLACE INTO daily_evidence(day, payload, updated_at) VALUES (?, ?, ?)",
            (day.isoformat(), json.dumps(result, ensure_ascii=False), dt.datetime.now().astimezone().isoformat()),
        )
        connection.commit()
    finally:
        connection.close()
    result["cache_database"] = str(database)
    emit(result)
    return 0


def first_line(text: str) -> str:
    return next((line.strip() for line in text.splitlines() if line.strip()), "")[:240]


def cmd_tools_audit(args: argparse.Namespace) -> int:
    tools = []
    for name in RECOMMENDED_TOOLS:
        path = shutil.which(name)
        item: dict[str, Any] = {"name": name, "available": bool(path), "path": path}
        if path and args.versions:
            for flag in ("--version", "-version", "-v"):
                result = run([path, flag])
                if result.returncode == 0 and (result.stdout or result.stderr):
                    item["version"] = first_line(result.stdout or result.stderr)
                    break
        tools.append(item)
    packages = []
    for name in RECOMMENDED_PYTHON_PACKAGES:
        probe = run([sys.executable, "-c", f"import {name}; print(getattr({name}, '__version__', 'unknown'))"])
        packages.append({
            "name": name,
            "available": probe.returncode == 0,
            "version": probe.stdout.strip() if probe.returncode == 0 else None,
        })
    token_path = agentctl_jira.TOKEN_PATH
    jira_token: dict[str, Any] = {"path": str(token_path), "present": token_path.is_file()}
    if token_path.is_file():
        try:
            jira_token.update(agentctl_jira.public_auth(agentctl_jira.load_credentials(token_path)))
        except (OSError, ValueError) as exc:
            jira_token["error"] = str(exc)
    nvidia_path = agents_home() / ".auth" / "nvidia-api-key.yaml"
    nvidia_token: dict[str, Any] = {"path": str(nvidia_path), "present": nvidia_path.is_file()}
    if nvidia_path.is_file():
        try:
            nvidia_token.update(public_nvidia_auth(nvidia_path))
        except (OSError, ValueError) as exc:
            nvidia_token["error"] = str(exc)
    emit({
        "available": sum(1 for item in tools if item["available"]),
        "missing": [item["name"] for item in tools if not item["available"]],
        "tools": tools,
        "python_packages": packages,
        "python_packages_missing": [item["name"] for item in packages if not item["available"]],
        "jira_token": jira_token,
        "nvidia_token": nvidia_token,
    })
    return 0


def scoped_files(cwd: Path, scope: str) -> tuple[Path, list[Path]]:
    root = repo_root(cwd) or cwd.resolve()
    excluded = {".git", "node_modules", "vendor", "build", "dist", ".gradle", ".venv", "venv"}

    def keep(path: Path) -> bool:
        return path.is_file() and not any(part in excluded for part in path.relative_to(root).parts)

    if scope == "changed" and repo_root(cwd):
        names: set[str] = set()
        for command in (
            ("diff", "--name-only"),
            ("diff", "--cached", "--name-only"),
            ("ls-files", "--others", "--exclude-standard"),
        ):
            result = git(root, *command)
            names.update(line for line in result.stdout.splitlines() if line)
        paths = [root / name for name in sorted(names) if keep(root / name)]
    else:
        paths = [path for path in root.rglob("*") if keep(path)]
    return root, paths[:500]


def cmd_checks_run(args: argparse.Namespace) -> int:
    root, paths = scoped_files(args.cwd.resolve(), args.scope)
    groups: dict[str, list[Path]] = {
        "python": [path for path in paths if path.suffix == ".py"],
        "php": [path for path in paths if path.suffix.lower() in {".php", ".phtml"}],
        "shell": [path for path in paths if path.suffix in {".sh", ".bash"}],
        "markdown": [path for path in paths if path.suffix.lower() in {".md", ".mdx"}],
        "xml": [path for path in paths if path.suffix.lower() == ".xml"],
        "yaml": [path for path in paths if path.suffix.lower() in {".yaml", ".yml"}],
    }
    # per_file: True when the CLI lints one path at a time (`php -l`).
    specs: list[tuple[str, str, list[str], list[Path], bool]] = [
        ("ruff", "ruff", ["check", "--output-format=json"], groups["python"], False),
        ("php", "php", ["-l"], groups["php"], True),
        ("shellcheck", "shellcheck", ["--format=json1"], groups["shell"], False),
        ("markdownlint", "markdownlint-cli2", [], groups["markdown"], False),
        ("xmllint", "xmllint", ["--noout"], groups["xml"], False),
        ("yq", "yq", ["."], groups["yaml"], False),
        ("codespell", "codespell", ["--quiet-level=2"], groups["python"] + groups["markdown"], False),
    ]
    checks: list[dict[str, Any]] = []
    for label, executable, prefix, selected, per_file in specs:
        path = shutil.which(executable)
        if not selected:
            checks.append({"check": label, "status": "skipped", "reason": "no matching files"})
            continue
        if not path:
            checks.append({"check": label, "status": "unavailable", "executable": executable})
            continue
        rels = [str(item.relative_to(root)) for item in selected[:200]]
        if per_file:
            chunks: list[str] = []
            exit_code = 0
            for rel in rels:
                result = run([path, *prefix, rel], cwd=root)
                chunk = (result.stdout + ("\n" if result.stdout and result.stderr else "") + result.stderr).strip()
                if chunk:
                    chunks.append(chunk)
                if result.returncode != 0:
                    exit_code = result.returncode
            output = "\n".join(chunks)
        else:
            result = run([path, *prefix, *rels], cwd=root)
            exit_code = result.returncode
            output = (result.stdout + ("\n" if result.stdout and result.stderr else "") + result.stderr).strip()
        checks.append({
            "check": label,
            "status": "passed" if exit_code == 0 else "failed",
            "exit_code": exit_code,
            "files": len(rels),
            "output": output[: argsafe_limit(args.max_output_chars)],
            "truncated": len(output) > args.max_output_chars,
        })
    failed = [item["check"] for item in checks if item["status"] == "failed"]
    emit({"repo": str(root), "scope": args.scope, "files": len(paths), "failed": failed, "checks": checks})
    return 2 if failed else 0


def _help_action(parser: argparse.ArgumentParser):
    """Default action for a group: print that group's own help, exit 0 (D16)."""
    def run(_args: argparse.Namespace) -> int:
        parser.print_help()
        return 0
    return run


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agentctl",
        description=(
            "Deterministic local primitives for agent workflows.\n\n"
            "agentctl keeps mechanical discovery, extraction, validation, and indexing "
            "off the model path. Commands emit bounded JSON so an agent can inspect a "
            "small result and open only the source artifacts it actually needs."
        ),
        epilog=(
            "Common examples:\n"
            "  agentctl repo detect --cwd .\n"
            "  agentctl delivery scope --cwd . --write-diff /tmp/delivery.patch\n"
            "  agentctl logs extract server.log --limit 20\n"
            "  agentctl evidence inspect screenshot.png --ocr --expected-text 'Saved'\n"
            "  agentctl jira fetch PROJ-1\n"
            "  agentctl playwright spawn JOT-101 --enable\n"
            "  agentctl playwright revive --default\n"
            "  agentctl security detect --cwd .\n"
            "  agentctl security scan --check secrets,deps --fail-on HIGH\n"
            "  agentctl skills scan ~/.agents/skills/find-skills\n"
            "  agentctl tools audit --versions\n\n"
            "Run 'agentctl GROUP --help' or 'agentctl GROUP COMMAND --help' for details."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    top = parser.add_subparsers(
        dest="group", required=False, title="command groups", metavar="GROUP"
    )

    def group(name: str, summary: str) -> argparse._SubParsersAction:
        group_parser = top.add_parser(
            name,
            help=summary,
            description=summary,
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        group_parser.set_defaults(func=_help_action(group_parser))
        return group_parser.add_subparsers(
            dest="action", required=False, title="commands", metavar="COMMAND"
        )

    task = group("task", "Resolve issue keys, kebab slugs, and task context from local inputs.")
    resolve = task.add_parser(
        "resolve",
        help="Resolve a task key from text, branch, or local files.",
        description=(
            "Resolve a Jira issue key or local kebab slug from explicit text and "
            "repository context. Text beats branch, cwd, and filename scans. "
            "Returns candidates, selected key, and mode (jira|local) as JSON."
        ),
    )
    resolve.add_argument("--cwd", type=Path, default=Path.cwd(), help="Repository or task directory.")
    resolve.add_argument("--text", default="", help="Prompt text or URL that may contain an issue key.")
    resolve.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    resolve.set_defaults(func=cmd_task_resolve)

    markdown = group("markdown", "Select named Markdown sections without loading the whole file.")
    slice_parser = markdown.add_parser(
        "slice",
        help="Return selected heading sections.",
        description="Extract selected Markdown sections and return bounded JSON.",
    )
    slice_parser.add_argument("file", type=Path, help="Markdown file to inspect.")
    slice_parser.add_argument(
        "--sections", required=True, help="Comma-separated heading names, case-insensitive."
    )
    slice_parser.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    slice_parser.set_defaults(func=cmd_markdown_slice)

    delivery = group("delivery", "Identify the current local delivery and its changed files.")
    scope = delivery.add_parser(
        "scope",
        help="Summarize the current delivery diff.",
        description=(
            "Inspect staged, unstaged, or branch changes without modifying git state. "
            "Optionally persist the full diff and return only its path and summary."
        ),
    )
    scope.add_argument("--cwd", type=Path, default=Path.cwd(), help="Git repository directory.")
    scope.add_argument("--base", help="Explicit base revision for branch-diff mode.")
    scope.add_argument("--write-diff", type=Path, help="Write the full diff to this path.")
    scope.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    scope.set_defaults(func=cmd_delivery_scope)

    repo = group("repo", "Detect repository stacks, manifests, and project-native checks.")
    detect = repo.add_parser(
        "detect",
        help="Detect repository structure and technology stacks.",
        description="Inspect local manifests and return stack/check hints without running builds.",
    )
    detect.add_argument("--cwd", type=Path, default=Path.cwd(), help="Repository directory.")
    detect.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    detect.set_defaults(func=cmd_repo_detect)

    plan = group("plan", "Create, resolve, and validate structured implementation or evidence plans.")
    agentctl_plan.add_plan_parsers(plan)

    logs = group("logs", "Extract and deduplicate important local log events.")
    extract = logs.add_parser(
        "extract",
        help="Return bounded error and warning blocks.",
        description=(
            "Extract selected log levels, retain attached stack lines, deduplicate volatile "
            "variants, and return at most the requested number of events."
        ),
    )
    extract.add_argument("file", type=Path, help="Log file to inspect.")
    extract.add_argument("--levels", default="ERROR,WARN,FATAL", help="Comma-separated levels.")
    extract.add_argument("--limit", type=int, default=50, help="Maximum unique events.")
    extract.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    extract.set_defaults(func=cmd_logs_extract)

    evidence = group("evidence", "Create and verify screenshot evidence metadata locally.")
    agentctl_image.add_evidence_parsers(evidence)

    image = group("image", "Deterministic and local-model image primitives for evidence review.")
    agentctl_image.add_image_parsers(image)

    playwright = group(
        "playwright",
        "On-demand Playwright MCP instances (HTTP, one process per task id).",
    )
    for playwright_action, playwright_help in (
        ("spawn", "Start one HTTP Playwright MCP per id."),
        ("revive", "Re-spawn dead instances from the registry (post-reboot)."),
        ("stop", "Kill instance processes and remove vendor MCP entries."),
        ("list", "Show instance registry."),
        ("enable", "Register a running instance on vendor MCP configs."),
        ("disable", "Remove playwright-<id> from vendor MCP configs."),
    ):
        pw = playwright.add_parser(playwright_action, help=playwright_help)
        pw.add_argument("playwright_args", nargs=argparse.REMAINDER, help="Args forwarded to mcp/playwright.py.")
        pw.set_defaults(func=cmd_playwright, action=playwright_action)

    worklog = group("worklog", "Collect bounded local evidence for daily worklogs.")
    collect = worklog.add_parser(
        "collect",
        help="Cache local work evidence for a date.",
        description="Collect local history and git evidence into dated raw and SQLite caches.",
    )
    collect.add_argument("--date", help="Date in YYYY-MM-DD; defaults to today.")
    collect.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    collect.set_defaults(func=cmd_worklog_collect)

    tools = group("tools", "Audit availability of local deterministic CLI dependencies.")
    audit = tools.add_parser(
        "audit",
        help="Report available and missing executables.",
        description="Check the shared local-tool catalog without installing or changing anything.",
    )
    audit.add_argument("--versions", action="store_true", help="Probe bounded version output.")
    audit.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    audit.set_defaults(func=cmd_tools_audit)

    checks = group("checks", "Run applicable local validators with bounded output.")
    check_run = checks.add_parser(
        "run",
        help="Run validators selected from repository contents.",
        description="Run only applicable local checks and return compact pass/fail/skip results.",
    )
    check_run.add_argument("--cwd", type=Path, default=Path.cwd(), help="Repository directory.")
    check_run.add_argument(
        "--scope", choices=("changed", "all"), default="changed", help="Files to validate."
    )
    check_run.add_argument(
        "--max-output-chars", type=int, default=12000, help="Maximum captured output per check."
    )
    check_run.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    check_run.set_defaults(func=cmd_checks_run)

    security = group(
        "security",
        "Run local security scans with CI-parity tools and summarize reports.",
    )
    agentctl_security.add_security_parsers(security)

    skills = group(
        "skills",
        "Audit skill metadata and scan skills for security risks.",
    )
    agentctl_skills.add_skills_parsers(skills)

    local = group("local", "Use bounded Ollama inference for low-risk local synthesis.")
    agentctl_docs.add_local_parsers(local)

    docs = group("docs", "Index and search local Markdown documentation with SQLite FTS.")
    agentctl_docs.add_docs_parsers(docs)

    kb = group("kb", "Import and export the local harness knowledge base.")
    agentctl_kb.add_kb_parsers(kb)

    jira = group(
        "jira",
        "Call Jira and Confluence Cloud REST with the local API token (no MCP/model loop).",
    )
    agentctl_jira.add_jira_parsers(jira)
    return parser


def main() -> int:
    parser = build_parser()
    args, unknown = parser.parse_known_args()
    if not hasattr(args, "func"):
        if unknown:
            parser.error("unrecognized arguments: " + " ".join(unknown))
        parser.print_help()
        return 0
    if args.func is cmd_playwright:
        extra = list(getattr(args, "playwright_args", None) or [])
        args.playwright_args = extra + unknown
        unknown = []
    if unknown:
        parser.error("unrecognized arguments: " + " ".join(unknown))
    try:
        return int(args.func(args))
    except (
        OSError,
        ValueError,
        subprocess.SubprocessError,
        agentctl_jira.JiraError,
        agentctl_kb.KbError,
    ) as exc:
        emit({"status": "error", "error": str(exc), "type": type(exc).__name__})
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
