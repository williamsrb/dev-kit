{
  "_comment": [
    "Slim profile for headless images that run extract-kit.",
    "",
    "It does not extend core: bootstrap.sh installs every dependency a profile",
    "declares, and core declares 34 entries (40 binaries). This type carries only",
    "what an extraction run needs. Versions are pinned so an image build is",
    "reproducible.",
    "",
    "dnf and pacman names for 7z are PROPOSED, like the rest of core."
  ],
  "name": "extract",
  "extends": null,
  "color": { "light": "#2f6feb", "dark": "#1b3a6b" },

  "deps": [
    { "provides": ["git"], "apt": "git", "dnf": "git", "pacman": "git" },
    { "provides": ["python3"], "apt": "python3", "dnf": "python3", "pacman": "python" },
    {
      "provides": ["cc", "make"],
      "apt": "build-essential",
      "dnf": "gcc gcc-c++ make",
      "pacman": "base-devel",
      "note": "Needed to compile npm native modules: graft pulls tree-sitter grammars that build through node-gyp."
    },
    { "provides": ["node", "npm"], "installer": "nvm", "version": "22.23.1" },
    { "provides": ["graft"], "installer": "npm", "package": "@nanonets/graft@0.19.0" },
    { "provides": ["serena"], "installer": "uv", "package": "serena-agent==1.7.0", "python": "3.13" },
    { "provides": ["graphify"], "installer": "uv", "package": "graphifyy==0.9.73" },
    { "provides": ["playwright-cli"], "optional": true, "installer": "npm", "package": "@playwright/cli@0.1.22" },
    {
      "provides": ["7z"],
      "apt": "p7zip-full",
      "dnf": "p7zip p7zip-plugins",
      "pacman": "p7zip",
      "needs_repo": { "rhel": "epel" }
    }
  ],

  "skills": ["graft", "playwright-cli"],
  "rules": [],
  "kb": ["implementation/**"],

  "mcp": ["serena"],

  "instances": [
    { "vendor": "claude", "kind": "cli" },
    { "vendor": "codex", "kind": "cli" },
    { "vendor": "cursor", "kind": "cli" }
  ]
}
