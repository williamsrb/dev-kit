{
  "comment": "User-level MCP servers extracted from the Cursor, Claude, and Codex config dirs. No secrets. Paths use ${HOME}.",
  "vendors": {
    "cursor": {
      "home": "${HOME}/.cursor"
    },
    "claude": {
      "home": "${HOME}/.claude",
      "claude_config_dir": "${HOME}/.claude"
    },
    "codex": {
      "home": "${HOME}/.codex"
    }
  },
  "env_files": {
    "browser_control": "${HOME}/.browser-control-mcp.env"
  },
  "servers": {
    "context7": {
      "transport": "http",
      "url": "https://mcp.context7.com/mcp",
      "auth": "oauth",
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": null
    },
    "atlassian-rovo-preview": {
      "transport": "http",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "auth": "oauth",
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": null
    },
    "gitlab": {
      "transport": "stdio",
      "command": "${HOME}/.agents/bin/gitlab-mcp",
      "args": [],
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "env": {
        "GITLAB_TOKEN_NAME": "pipelines_token",
        "GITLAB_MCP_READ_ONLY": "true"
      },
      "fetch": "gitlab-mcp-server",
      "comment": "Read-only. Wrapper injects GITLAB_TOKEN/URL from AGENTS_HOME/.auth; do not put the PAT in mcp.json."
    },
    "gitlab-factory": {
      "transport": "stdio",
      "command": "${HOME}/.agents/bin/gitlab-mcp",
      "args": [],
      "env": {
        "GITLAB_TOKEN_NAME": "factory_token",
        "GITLAB_MCP_READ_ONLY": "false"
      },
      "vendors": ["claude"],
      "fetch": null,
      "comment": "Read-write, same binary as gitlab. Registered for Claude only (operator order 2026-10-27) so an interactive session can use it; the factory also passes it to its workers with --mcp-config."
    },
    "browser-control": {
      "transport": "stdio",
      "command": "node",
      "args": [
        "${HOME}/.local/src/browser-control-mcp/mcp-server/dist/server.js"
      ],
      "env_file": "browser_control",
      "env_keys": [
        "EXTENSION_SECRET",
        "EXTENSION_PORT"
      ],
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": "browser-control-mcp"
    },
    "slack-workspace-leanon": {
      "transport": "http",
      "url": "https://mcp.slack.com/mcp?ws=leanon",
      "auth": "slack",
      "oauth_client_id_env": "SLACK_MCP_CLIENT_ID",
      "bearer_env": "SLACK_MCP_TOKEN",
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "vendor_overrides": {
        "codex": {
          "url": "https://mcp.slack.com/mcp"
        }
      },
      "fetch": null
    },
    "playwright": {
      "transport": "http",
      "url": "http://localhost:8931/mcp",
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "fetch": "playwright-mcp",
      "comment": "Parked. Spawn isolated HTTP instances with mcp/playwright.py; do not register this stub."
    },
    "serena": {
      "transport": "stdio",
      "command": "${HOME}/.agents/bin/serena-mcp",
      "comment": "Wrapper adds the top source languages (agentctl code languages) to .serena/project.yml, then execs ${HOME}/.local/bin/serena.",
      "args": [
        "start-mcp-server",
        "--project-from-cwd",
        "--context=ide"
      ],
      "vendors": [
        "cursor",
        "claude",
        "codex"
      ],
      "vendor_overrides": {
        "claude": {
          "args": [
            "start-mcp-server",
            "--project-from-cwd",
            "--context=claude-code"
          ]
        },
        "codex": {
          "args": [
            "start-mcp-server",
            "--project-from-cwd",
            "--context=codex"
          ]
        }
      },
      "fetch": "serena-agent"
    }
  },
  "skip": {
    "node_repl": "Codex Desktop bundled binary under /opt/codex-desktop; not a user-installable MCP.",
    "graft": "removed 2026-09-27; Graft CLI only; do not register MCP"
  },
  "parked": {
    "slack-workspace-leanon": "generate-worklogs only; snippets in ${HOME}/.agents/.auth/mcp-on-demand/",
    "playwright": "on-demand HTTP via mcp/playwright.py; one process and output-dir per id. Do not register this stub.",
    "browser-control": "on-demand; snippets in ${HOME}/.agents/.auth/mcp-on-demand/"
  },
  "plugins_not_user_mcp": {
    "comment": "Marketplace plugins that also expose MCP tools. Installed via each vendor's plugin UI/CLI, not mcp add. A plain server in `servers` wins: do not install a plugin whose MCP duplicates one (atlassian plugins removed 2026-11-16 for atlassian-rovo-preview).",
    "slack@claude-plugins-official": [
      "codex"
    ]
  },
  "fetch": {
    "gitlab-mcp-server": {
      "version": "3.6.0",
      "dest": "${HOME}/.local/bin/gitlab-mcp-server",
      "url": "https://github.com/jmrplens/gitlab-mcp-server/releases/download/v3.6.0/gitlab-mcp-server-linux-amd64"
    },
    "browser-control-mcp": {
      "repo": "https://github.com/eyalzh/browser-control-mcp.git",
      "dest": "${HOME}/.local/src/browser-control-mcp",
      "build": [
        "npm",
        "install"
      ]
    },
    "playwright-mcp": {
      "npx_package": "@playwright/mcp@latest"
    },
    "serena-agent": {
      "uv_tool": "serena-agent",
      "python": "3.13"
    }
  }
}
